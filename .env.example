# ============================================================
# TRAQ-IQ Environment Variables
# Copy this file to .env and fill in your values.
# Set all of these in Railway's "Variables" tab.
# ============================================================

# ── Core ────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-random-secret

# ── Database (Neon PostgreSQL) ───────────────────────────────
# Get from https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Twilio (SMS) ─────────────────────────────────────────────
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Update this to your Railway app URL after deploying
TWILIO_WEBHOOK_URL=https://your-app.railway.app/api/sms/webhook

# ── OpenAI ───────────────────────────────────────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Unified Call-Data Layer (SP1) ────────────────────────────
# Master switch for call transcription + classification. Default OFF.
# Turn on ONLY with owner approval — this starts OpenAI (Whisper + gpt-4o) spend.
CALL_INTAKE_ENABLED=false
# Only recordings created at/after this ISO timestamp are processed
# (watermark — prevents processing the historical backlog when you enable).
# Set it to "now" the moment you flip CALL_INTAKE_ENABLED=true.
CALL_INTAKE_START_AT=
# Cost guards (optional; defaults shown)
CALL_TRANSCRIBE_MAX_SEC=1200
CALL_TRANSCRIBE_MAX_PER_HOUR=30

# --- Per-driver recorded lines (SP2) ---
# Allows the provisioning flow to BUY a new Twilio number when no spare is free.
# Default OFF — with it off, provisioning only reuses idle owned numbers.
DRIVER_LINE_PROVISION_ENABLED=false
# Public base URL Twilio dials back for the driver inbound webhook.
VOICE_WEBHOOK_BASE=https://traqiq.app

# --- In-portal outbound dialer (SP3) ---
# Master switch. Default OFF — the voice-token endpoint refuses when off, so the
# dialer can't initialize and no outbound call is possible.
PORTAL_DIALER_ENABLED=false
# Created in Twilio (see the enablement steps): a TwiML App + a standalone API key.
TWILIO_TWIML_APP_SID=AP...
TWILIO_API_KEY=SK...
TWILIO_API_SECRET=...
# Caller ID for all outbound driver calls (the company toll-free). Optional; defaults to +18333629813.
PORTAL_CALLER_ID=+18333629813
# Play a "this call is recorded" notice to the called party. Default on.
PORTAL_DIALER_RECORDING_NOTICE=true
# Per-driver hourly call ceiling (abuse/runaway guard). Default 20.
PORTAL_DIALER_MAX_PER_HOUR=20

# ── Google / Gmail ───────────────────────────────────────────
# For BOL email ingestion - set up OAuth at https://console.cloud.google.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── Google Sign-In (dispatcher/admin login) ──────────────────
# Create OAuth Client ID @ https://console.cloud.google.com/apis/credentials
#   Type: Web application
#   Authorized redirect URI: https://traqiq.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/api/auth/google/callback

# Email allowlist — only these Google accounts can sign in.
# Leaving this empty in production blocks ALL Google logins (safety).
AUTH_ALLOWED_EMAILS=annex561@gmail.com

# Per-email role assignment. Default for unmapped emails = dispatcher.
# Roles: admin (full access) | dispatcher (ratecon ops) | viewer (read-only)
AUTH_ROLE_MAP=annex561@gmail.com:admin

# ── DAT Load Board ───────────────────────────────────────────
DAT_API_KEY=
DAT_CLIENT_ID=
DAT_EMAIL=
DAT_PASSWORD=

# ── Stripe (Billing) ─────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Telegram (Optional notifications) ────────────────────────
TELEGRAM_BOT_TOKEN=
DISPATCHER_TELEGRAM_ID=
DISPATCHER_CHAT_ID=

# ── Company Info ─────────────────────────────────────────────
COMPANY_EMAIL=
COMPANY_PHONE=
DOT_NUMBER=
MC_NUMBER=
DISPATCHER_PHONE_NUMBER=

# ── FMCSA monitor (daily SAFER check → SMS on status change) ──
# Default OFF. Set ENABLED=true to schedule. Watches FMCSA_MONITOR_DOT and texts
# FMCSA_ALERT_PHONE (falls back to DISPATCHER_PHONE_NUMBER) when authority / OOS /
# USDOT status / MCS-150 staleness changes. First-ever check records a baseline
# silently (no alert). SMS_DISABLED=true halts it; FMCSA_MONITOR_DISABLED=true is
# a dedicated kill switch.
FMCSA_MONITOR_ENABLED=false
FMCSA_MONITOR_DISABLED=
FMCSA_MONITOR_DOT=
FMCSA_ALERT_PHONE=
FMCSA_MONITOR_CRON=0 8 * * *
# Shared secret to allow POST /api/fmcsa-monitor/run (manual verification tick).
CRON_TRIGGER_KEY=

# ── FreightGuard monitor (Carrier411 report → SMS alert) ─────
# Default OFF. Carrier411 FreightGuard notification emails are POSTed to
# /api/freightguard/ingest (key-gated by CRON_TRIGGER_KEY) by a Gmail filter /
# Apps Script; the cron then SMSes FREIGHTGUARD_ALERT_PHONE (falls back to
# FMCSA_ALERT_PHONE / DISPATCHER_PHONE_NUMBER) about any open, un-alerted case so
# the operator catches the 72-hour clock. One SMS per report (dedup), watermark
# suppresses reports older than the window, rate-capped per tick.
FREIGHTGUARD_MONITOR_ENABLED=false
FREIGHTGUARD_MONITOR_DISABLED=
FREIGHTGUARD_ALERT_PHONE=
FREIGHTGUARD_MONITOR_CRON=*/10 * * * *
FREIGHTGUARD_MAX_ALERTS_PER_TICK=3
FREIGHTGUARD_ALERT_MAX_AGE_HOURS=96

# ── App URLs ─────────────────────────────────────────────────
# Set after Railway gives you a URL, and after you connect traqiqs.io
BASE_URL=https://traqiqs.io
API_BASE_URL=https://traqiqs.io

# ── Email (SMTP - optional if using Gmail OAuth above) ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Admin ────────────────────────────────────────────────────
ADMIN_API_KEY=replace-with-random-string

# --- Trip Lease Addendum (split-authority owner-operators) ------------------
# Per-load Trip Addendum for drivers who hold their own MC and run part-time under
# LAMP's authority (docs/agreements/master-trip-lease-lamp-to-owner-operator.md).
# DEFAULT OFF. Also requires drivers.split_authority_enabled=true on the driver row,
# so an ordinary driver is never affected. Creates a DocuSeal submission with
# send_email:false / send_sms:false — no Twilio, no SMTP, no billable vendor traffic.
# Turning this OFF instantly stops all addendum creation without touching credentials.
TRIP_ADDENDUM_ENABLED=false
DOCUSEAL_TRIP_ADDENDUM_BOX_TEMPLATE_ID=
DOCUSEAL_TRIP_ADDENDUM_TRACTOR_TEMPLATE_ID=

# --- COI lapse monitor (owner-operator insurance expiry) --------------------
# Daily check of split-authority drivers' certificates; SMSes the OPERATOR (never the
# driver) when one crosses 30 / 14 / 7 / 1 days or expires.
# DEFAULT OFF. Guards: baseline watermark (first sight never alerts, so a deploy against
# a backlog of expired certs sends zero), per-document monotonic dedup (one SMS per
# threshold per document, ever), and a hard per-tick ceiling.
# Kill switches: COI_MONITOR_DISABLED=true, or the universal SMS_DISABLED=true.
COI_MONITOR_ENABLED=false
COI_MONITOR_DISABLED=false
COI_MONITOR_CRON=0 13 * * *
COI_MONITOR_MAX_PER_TICK=5
COI_ALERT_PHONE=

# --- Shared-truck first look (split-authority owner-operators) --------------
# Hours LAMP has an exclusive right to offer the next load after the truck frees up.
# After this the truck opens to the driver's own authority — silence is a pass.
# Only affects drivers with split_authority_enabled=true. Default 4.
TRIP_FIRST_LOOK_HOURS=4

# --- Truck-free driver notification ----------------------------------------
# The ONLY split-authority path that texts a DRIVER. "Your truck is free in Atlanta.
# We have first look until 3:00 PM." DEFAULT OFF.
# Guards: baseline watermark (a deploy never texts on its first tick), per-LOAD dedup
# (one text per freeing load, ever), a hard recency bound so a redeploy can only reach
# drivers freed in the last LOOKBACK minutes, a per-tick ceiling, and quiet hours.
# Kill switches: TRUCK_FREE_SMS_DISABLED=true, or the universal SMS_DISABLED=true.
TRUCK_FREE_SMS_ENABLED=false
TRUCK_FREE_SMS_DISABLED=false
TRUCK_FREE_SMS_CRON=*/15 * * * *
TRUCK_FREE_MAX_PER_TICK=3
TRUCK_FREE_LOOKBACK_MINUTES=120
# Send window in UTC. 12->2 is roughly 7 AM to 9 PM Central. Set equal values to disable.
TRUCK_FREE_SEND_START_UTC=12
TRUCK_FREE_SEND_END_UTC=2
